# Discord bot application
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
REQUIRED_ROLE_ID=

# Optional: comma-separated proxy URLs used for outbound calls to the
# Alphabot API only (never for Discord). Leave unset to disable — behavior
# is unchanged and all traffic goes out on Railway's normal IP.
#
# Each user is deterministically assigned one proxy from the pool (sticky
# by Discord ID), spreading load across the pool instead of having every
# user's raffle entries originate from a single shared IP.
#
# Format: http://user:pass@host:port,http://user:pass@host2:port
ALPHABOT_PROXY_LIST=
